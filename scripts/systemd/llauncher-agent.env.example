# llauncher agent environment file.
#
# install.sh generates the live copy at:
#   ~/.config/llauncher/agent.env  (mode 0600)
# Edit the live copy to customize this host; this .example is a
# reference template tracked in git.
#
# Format: systemd EnvironmentFile syntax (KEY=VALUE, no `export`,
# no shell expansion, no quoting needed unless the value contains
# whitespace).

# --- Required ---------------------------------------------------------

# Bearer token enforced by the agent's auth middleware
# (llauncher/agent/server.py:281). Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
LAUNCHER_AGENT_TOKEN=replace-me-with-a-random-token

# --- Network ----------------------------------------------------------

# Bind interface. Default in code is 127.0.0.1 (loopback only).
# Set to 0.0.0.0 for multi-workstation visibility, OR to a specific
# LAN address to scope exposure. The token above is the only auth
# layer — do not bind to 0.0.0.0 on an untrusted network.
LAUNCHER_AGENT_HOST=0.0.0.0

# Port. Default 8765.
LAUNCHER_AGENT_PORT=8765

# --- Identity ---------------------------------------------------------

# Friendly name shown in the UI's node selector and audit log.
# Defaults to the hostname if unset; set explicitly when you want
# the dashboard to read "workstation-a" instead of "shane-laptop".
LAUNCHER_AGENT_NODE_NAME=
