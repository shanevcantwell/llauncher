# llauncher Environment Configuration

# Path to llama-server binary (default: ~/.local/bin/llama-server)
# LLAMA_SERVER_PATH=/path/to/llama-server

# Path to launch scripts directory (default: ~/.local/bin)
# SCRIPTS_PATH=~/.local/bin

# Seed port for the port-scanner used by start operations.
# Default 8081 because 8080 commonly collides with other local services
# (searxng, Apache fronts, …). Override per-host as needed.
# DEFAULT_PORT=8081

# Blacklisted ports (comma-separated). 8080 is blacklisted by default to
# avoid colliding with searxng / generic web services.
# BLACKLISTED_PORTS=8080

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
